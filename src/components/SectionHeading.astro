---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}
const { eyebrow, title, lead, align = 'left', class: cls = '' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', cls]}>
  {eyebrow && <span class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</span>}
  <h2 class="h2 mt-4">{title}</h2>
  {lead && <p class="lead mt-5">{lead}</p>}
</div>
