---
import { withBase } from '../lib/url';
import { COMPANY } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  variant?: 'navy' | 'light';
}
const {
  title = 'Tell us about your home',
  text = 'Share a few details and we’ll come back with a clear, transparent quote — usually the same day.',
  variant = 'navy',
} = Astro.props;
const navy = variant === 'navy';
---
<section class:list={['section', navy ? 'on-navy' : 'bg-white']}>
  <div class="container-x">
    <div class:list={[
      'relative overflow-hidden rounded-3xl px-8 py-14 sm:px-14 lg:px-20 lg:py-20',
      navy ? 'bg-navy-700 ring-1 ring-white/10' : 'bg-offwhite ring-1 ring-line',
    ]}>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <span class="eyebrow">Get started</span>
          <h2 class="h2 mt-4 max-w-xl">{title}</h2>
          <p class:list={['lead mt-5 max-w-lg', navy && 'text-white/70']}>{text}</p>
        </div>
        <div class="flex flex-col gap-3 lg:items-end">
          <a href={withBase('/contact')} class="btn-primary w-full sm:w-auto">Request a quote</a>
          <a href={COMPANY.whatsappMessage} data-track="whatsapp_click" class="btn-whatsapp w-full sm:w-auto">Chat on WhatsApp</a>
          <a href={COMPANY.phoneHref} data-track="call_click" class:list={['w-full text-center text-sm font-semibold sm:w-auto', navy ? 'text-white/80 hover:text-white' : 'text-navy hover:text-blue-600']}>or call {COMPANY.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
