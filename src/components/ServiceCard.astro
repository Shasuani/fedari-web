---
import ServiceIcon from './ServiceIcon.astro';
import { serviceUrl } from '../data/site';
import { withBase } from '../lib/url';
interface Props { slug: string; title: string; short: string; icon: string; }
const { slug, title, short, icon } = Astro.props;
const img = withBase(`/images/services/${slug}.jpg`);
---
<a
  href={withBase(serviceUrl(slug))}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-card transition duration-300 ease-lux hover:-translate-y-1 hover:border-blue/30 hover:shadow-lift"
>
  <div class="relative aspect-[16/10] overflow-hidden">
    <img
      src={img}
      alt={`${title} for Dubai villas and townhouses`}
      width="640" height="400"
      loading="lazy" decoding="async"
      class="h-full w-full object-cover transition duration-700 ease-lux group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy/50 via-navy/5 to-transparent"></div>
    <span class="absolute bottom-3 left-3 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/95 text-blue-600 shadow-sm backdrop-blur">
      <ServiceIcon name={icon} />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold text-navy transition-colors duration-200 ease-lux group-hover:text-blue-600">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{short}</p>
    <span class="link-arrow mt-auto pt-5">
      Learn more
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
