---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import LeadForm from '../components/LeadForm.astro';
import { COMPANY } from '../data/site';
import { breadcrumbLd } from '../data/jsonld';

const emergencyFields = [
  { name: 'name', label: 'Full name', type: 'text', required: true, autocomplete: 'name' },
  { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
  { name: 'community', label: 'Location / community', type: 'text', required: true, placeholder: 'e.g. DAMAC Lagoons', list: COMPANY.communities },
  { name: 'emergency_type', label: 'Type of emergency', type: 'select', required: true, options: ['Water leak or flooding', 'AC failure', 'Electrical fault or outage', 'Plumbing issue', 'Other urgent repair'] },
  { name: 'description', label: 'What is happening?', type: 'textarea', required: true, placeholder: 'A short description helps us arrive ready to fix.' },
  { name: 'photos', label: 'Photos or video', type: 'file', accept: 'image/*,video/*', multiple: true, help: 'Optional — showing the issue helps us prepare.' },
  { name: 'call_permission', label: 'You may call me right away.', type: 'checkbox' },
];

const categories = [
  {
    t: 'Water leak or flooding',
    d: 'Burst pipes, overflowing tanks, water coming through a ceiling or under a wall.',
    first: 'What to do first: shut off the main water valve if you can reach it safely, then move valuables clear of the water.',
  },
  {
    t: 'AC failure',
    d: 'Cooling has stopped in Dubai heat, a unit is leaking, or the system keeps tripping.',
    first: 'What to do first: switch the unit off at the wall, close doors and blinds to hold the cool, and note any error lights.',
  },
  {
    t: 'Electrical fault or outage',
    d: 'A tripped board that will not reset, burning smells, sparking sockets or a full power loss.',
    first: 'What to do first: stop using the affected sockets, keep clear of anything sparking or hot, and leave the main board off if in doubt.',
  },
  {
    t: 'Urgent repairs',
    d: 'A jammed or broken entry door, a failed lock, a smashed window or anything that leaves the villa unsafe.',
    first: 'What to do first: secure the area as best you can and keep people and pets away from broken glass or exposed fittings.',
  },
];

const send = [
  { q: 'Your location', a: 'Share the community, villa or plot number, and a pin if you can. It helps us route the nearest available technician.' },
  { q: 'Photos or a short video', a: 'A quick clip of the leak, unit or fault tells us what tools and parts to bring, so the first visit counts.' },
  { q: 'Access details', a: 'Let us know how we get in, whether someone will be home, and any gate, security or parking instructions.' },
];

const breadcrumb = breadcrumbLd([
  { name: 'Home', path: '/' },
  { name: 'Emergency Repairs', path: '/emergency-repairs' },
]);
---
<BaseLayout
  title="24/7 Emergency Villa Repairs in Dubai"
  description="Fedari runs a 24/7 emergency line for Dubai villas and townhouses — water leaks, AC failures, electrical faults and urgent repairs. Call or message and we give you a realistic response time."
  path="/emergency-repairs"
  transparentHeader={false}
  jsonLd={breadcrumb}
>
  <!-- HERO -->
  <section class="on-navy relative overflow-hidden bg-navy">
    <div class="container-x section-tight relative pt-28 lg:pt-36">
      <div class="max-w-3xl text-white">
        <span class="eyebrow text-blue-100"><span class="!bg-blue-100/80"></span>Emergency line · staffed 24/7</span>
        <h1 class="display mt-5 text-white">24/7 emergency villa repairs in Dubai</h1>
        <p class="lead mt-6 max-w-2xl text-white/80">A leak, an AC breakdown or a power fault can’t wait. Our line is answered around the clock — call or message now and we’ll give you a realistic time to reach you.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={COMPANY.phoneHref} data-track="call_click" class="btn-primary">Call {COMPANY.phone}</a>
          <a href={COMPANY.whatsappMessage} data-track="whatsapp_click" class="btn-whatsapp">Message on WhatsApp</a>
        </div>
        <p class="mt-5 text-sm text-white/60">Answered 24/7, every day. When you reach us we confirm a realistic ETA — no automated queues.</p>
      </div>
    </div>
  </section>

  <!-- EMERGENCY CATEGORIES -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading eyebrow="Common emergencies" title="Tell us what’s happening" lead="Four situations we handle most often. Each has one calm step you can take before we arrive." />
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {categories.map((c) => (
          <div class="reveal card">
            <h3 class="text-lg font-semibold text-navy">{c.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{c.d}</p>
            <p class="mt-4 border-t border-line pt-4 text-sm font-medium leading-relaxed text-navy">{c.first}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RESPONSE PROMISE -->
  <section class="section bg-offwhite">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <SectionHeading eyebrow="Our response promise" title="A real person, a realistic time" lead="We don’t publish fixed minute targets we can’t keep across every community. Here’s what we do commit to." />
      <div class="reveal grid gap-6 sm:grid-cols-1">
        {[
          { t: 'The line is staffed 24/7', d: 'Day or night, weekend or holiday, a real person answers and starts helping straight away.' },
          { t: 'A realistic ETA when you call', d: 'We check who is nearest and available, then tell you honestly how soon we can be with you.' },
          { t: 'Clear next steps before we hang up', d: 'You’ll know what to do in the meantime, what we’re bringing and what to expect on arrival.' },
        ].map((p, i) => (
          <div class="reveal card">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-blue-600">{String(i + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-line"></span>
            </div>
            <h3 class="mt-3 text-base font-semibold text-navy">{p.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT TO SEND US -->
  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow="What to send us" title="Three things that speed us up" lead="Send these with your first message and we can arrive ready to fix, not just to assess." />
      <div class="divide-y divide-line border-t border-line">
        {send.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-navy [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg class="shrink-0 transition group-open:rotate-45" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146BFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- EMERGENCY REQUEST FORM -->
  <section class="section bg-white">
    <div class="container-x grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="reveal">
        <SectionHeading eyebrow="Send a request" title="Can’t call right now? Send the details" lead="Calling is fastest for a genuine emergency. If you can’t talk, send this and we’ll call you straight back." />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={COMPANY.phoneHref} data-track="call_click" class="btn-primary">Call {COMPANY.phone}</a>
          <a href={COMPANY.whatsappMessage} data-track="whatsapp_click" class="btn-whatsapp">WhatsApp</a>
        </div>
      </div>
      <LeadForm
        id="emergency-request"
        class="reveal rounded-3xl bg-offwhite p-7 ring-1 ring-line sm:p-10"
        fields={emergencyFields}
        submitLabel="Send emergency request"
        track="generate_lead"
        successTitle="Request received — we’re on it"
        successText="We have your details and will call you back right away. If anything changes, call or WhatsApp us directly."
      />
    </div>
  </section>

  <!-- REPEAT CTA -->
  <section class="on-navy relative overflow-hidden bg-navy">
    <div class="container-x section flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl text-white">
        <span class="eyebrow text-blue-100">Ready when you are</span>
        <h2 class="h2 mt-4 text-white">Call now and we’ll take it from here</h2>
        <p class="lead mt-4 text-white/70">One call reaches a real person who can dispatch help and talk you through the next few minutes.</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={COMPANY.phoneHref} data-track="call_click" class="btn-primary w-full sm:w-auto">Call {COMPANY.phone}</a>
        <a href={COMPANY.whatsappMessage} data-track="whatsapp_click" class="btn-whatsapp w-full sm:w-auto">Message on WhatsApp</a>
      </div>
    </div>
  </section>

  <QuoteCTA
    title="Not an emergency? Get a quote instead"
    text="For planned repairs and maintenance, share a few details and we’ll come back with a clear, transparent quote — usually the same day."
  />
</BaseLayout>
