---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import { FAQ_GROUPS } from '../data/faqs';
import { faqLd, breadcrumbLd } from '../data/jsonld';

const allItems = FAQ_GROUPS.flatMap((g) => g.items);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const jsonLd = [
  faqLd(allItems),
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]),
];
---
<BaseLayout
  title="Frequently asked questions"
  description="Answers to common questions about Fedari's villa services, pricing and quotes, emergencies, maintenance plans and careers in Dubai."
  path="/faq"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="section-tight bg-white pt-28 lg:pt-36">
    <div class="container-x">
      <div class="max-w-2xl reveal">
        <span class="eyebrow">FAQ</span>
        <h1 class="display mt-5">Frequently asked questions</h1>
        <p class="lead mt-6">Clear answers on our services, pricing, emergencies, maintenance plans and careers. If your question is not here, get in touch and we will help.</p>
      </div>
    </div>
  </section>

  <!-- FAQ GROUPS -->
  <section class="section-tight bg-offwhite pt-0">
    <div class="container-x grid gap-12 lg:grid-cols-[0.32fr_1fr] lg:gap-16">
      <!-- STICKY IN-PAGE NAV -->
      <nav aria-label="FAQ categories" class="hidden lg:block">
        <div class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-widest text-blue-600">On this page</p>
          <ul class="mt-5 space-y-3">
            {FAQ_GROUPS.map((g) => (
              <li>
                <a href={`#${slug(g.category)}`} class="text-sm font-medium text-muted transition hover:text-navy">{g.category}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- GROUPS -->
      <div class="space-y-16">
        {FAQ_GROUPS.map((group) => (
          <section id={slug(group.category)} class="reveal">
            <h2 class="h3 border-b border-line pb-4">{group.category}</h2>
            <div class="divide-y divide-line">
              {group.items.map((f) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-navy [&::-webkit-details-marker]:hidden">
                    {f.q}
                    <svg class="shrink-0 transition group-open:rotate-45" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146BFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <QuoteCTA />
</BaseLayout>
