---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import { COMPANY, SERVICES, serviceUrl } from '../../data/site';
import { SERVICE_DETAILS } from '../../data/services';
import { serviceLd, faqLd, breadcrumbLd } from '../../data/jsonld';

export function getStaticPaths() {
  return SERVICES.map((s) => ({
    params: { slug: s.slug },
    props: { summary: s },
  }));
}

const { summary } = Astro.props;
const { slug, title } = summary;
const detail = SERVICE_DETAILS[slug];
const path = serviceUrl(slug);

const others = SERVICES.filter((s) => s.slug !== slug);

const jsonLd = [
  serviceLd({ name: title, description: detail.metaDescription, path }),
  faqLd(detail.faqs),
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: title, path },
  ]),
];
---
<BaseLayout
  title={detail.metaTitle}
  description={detail.metaDescription}
  path={path}
  image={detail.image}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="section-tight bg-white pt-28 lg:pt-36">
    <div class="container-x">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
          <li><a href="/" class="transition-colors duration-200 ease-lux hover:text-blue-600">Home</a></li>
          <li aria-hidden="true" class="text-line">/</li>
          <li><a href="/services" class="transition-colors duration-200 ease-lux hover:text-blue-600">Services</a></li>
          <li aria-hidden="true" class="text-line">/</li>
          <li class="font-medium text-navy" aria-current="page">{title}</li>
        </ol>
      </nav>

      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
        <div>
          <span class="eyebrow">Service</span>
          <h1 class="display mt-5">{title}</h1>
          <p class="lead mt-6 max-w-xl font-medium text-navy">{detail.heroBenefit}</p>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">{detail.intro}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/contact" class="btn-primary">Get a quote</a>
            <a href={COMPANY.whatsappMessage} data-track="whatsapp_click" class="btn-whatsapp">Chat on WhatsApp</a>
          </div>
        </div>
        <div class="reveal relative overflow-hidden rounded-3xl">
          <img
            src={detail.image}
            alt={`${title} for Dubai villas and townhouses — Fedari`}
            width="1000"
            height="1120"
            fetchpriority="high"
            decoding="async"
            class="aspect-[5/6] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON PROBLEMS -->
  <section class="section bg-offwhite">
    <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading eyebrow="What we fix" title="Common problems we fix" lead="If any of these sound familiar, we can help — and we tell you the real cause before quoting a repair." />
      <ul class="grid gap-4 sm:grid-cols-2">
        {detail.commonProblems.map((p) => (
          <li class="reveal card flex items-start gap-4">
            <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-600" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
            </span>
            <span class="text-sm leading-relaxed text-navy">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading eyebrow="Our work" title="What we do" lead="A qualified technician handles the job properly and documents it with photos you keep." />
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {detail.whatWeDo.map((w) => (
          <li class="reveal flex items-start gap-3">
            <svg class="mt-1 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#146BFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-sm leading-relaxed text-navy">{w}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-offwhite">
    <div class="container-x">
      <SectionHeading eyebrow="How it works" title="Simple from first message to finished job" align="center" class="mx-auto" />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {detail.process.map((step, i) => (
          <div class="reveal card">
            <span class="text-3xl font-bold text-blue/20">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3 mt-3">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow="FAQ" title={`${title} questions, answered`} lead="Plain answers to what clients ask most before they get in touch." />
      <div class="divide-y divide-line border-t border-line">
        {detail.faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-navy [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg class="shrink-0 transition group-open:rotate-45" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146BFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPLORE OTHER SERVICES -->
  <section class="section bg-offwhite">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading eyebrow="More care" title="Explore other services" lead="One accountable team across every part of your villa." />
        <a href="/services" class="link-arrow shrink-0">View all services
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((s) => (
          <div class="reveal"><ServiceCard {...s} /></div>
        ))}
      </div>
    </div>
  </section>

  <QuoteCTA />
</BaseLayout>
